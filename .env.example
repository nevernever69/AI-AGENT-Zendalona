# Chroma DB settings
chroma_db_path=./chroma_db
log_path=./app.log
gemini_api_key=your_gemini_api_key_here

# Crawler settings
crawler_depth=2
crawler_max_pages=50
document_store_path=./documents

# Server settings
PORT=10000

# MongoDB settings
mongodb_uri=mongodb://localhost:27017/
mongodb_database=zendalona
mongodb_feedback_collection=feedback

# Vector DB retrieval settings
retrieval_k=6
retrieval_threshold=0.7
max_context_docs=4

# Disable Gemini calls for testing
disable_gemini_call=false